{
  "info": {
    "name": "SWD Backend — School API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "REST API ระบบโรงเรียนด้วย Go/Echo/GORM รันทุก folder ตามลำดับด้วย Collection Runner เพื่อสร้าง อ่าน แก้ไข ตรวจ errors และลบข้อมูลตัวอย่าง ตั้ง base_url ให้ตรงกับ API ก่อนรัน การรันชุดเต็มจะลบข้อมูลตัวอย่างที่ตัวเองสร้าง หากรันเฉพาะ request ให้กำหนด ID variables เองหรือรัน Create sample data ก่อน ถ้าหยุดกลางทาง สามารถรัน Cleanup sample data ด้วย variables ชุดเดิมเพื่อลบข้อมูลที่สร้างแล้ว"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "school_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "classroom_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "teacher_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "student_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Health",
      "description": "ตรวจว่าระบบพร้อมใช้งาน",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/healthz"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Success envelope\", function () { pm.expect(body).to.have.property(\"data\"); });",
                  "  pm.test(\"Healthy\", function () { pm.expect(body.data.status).to.equal(\"ok\"); });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "02 Create sample data",
      "description": "สร้างข้อมูลตามความสัมพันธ์ และเก็บ ID จาก data.id ลง collection variables อัตโนมัติ",
      "item": [
        {
          "name": "Create school",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/schools",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Swift Postman School\",\n  \"abbreviation\": \"SWD\",\n  \"address\": \"Bangkok\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"school_id\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Success envelope\", function () { pm.expect(body).to.have.property(\"data\"); });",
                  "  pm.collectionVariables.set(\"school_id\", String(body.data.id));",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
