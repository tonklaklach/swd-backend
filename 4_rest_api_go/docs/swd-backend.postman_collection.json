    {
      "name": "06 Validation and conflict examples",
      "description": "ตัวอย่างที่คาดหวังให้ตอบ 4xx และตรวจ error code ตามที่กำหนด",
      "item": [
        {
          "name": "Reject blank school name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/schools",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \" \",\n  \"abbreviation\": \"SWD\",\n  \"address\": \"Bangkok\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 422\", function () { pm.response.to.have.status(422); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "if (pm.response.code === 422) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Error envelope\", function () { pm.expect(body.code).to.be.a(\"string\").and.not.empty; pm.expect(body.error).to.be.a(\"string\").and.not.empty; });",
                  "  pm.test(\"Validation code\", function () { pm.expect(body.code).to.equal(\"VALIDATION_FAILED\"); });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Reject invalid pagination",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/schools?limit=101"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "if (pm.response.code === 400) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Error envelope\", function () { pm.expect(body.code).to.be.a(\"string\").and.not.empty; pm.expect(body.error).to.be.a(\"string\").and.not.empty; });",
                  "  pm.test(\"Bad request code\", function () { pm.expect(body.code).to.equal(\"BAD_REQUEST\"); });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Prevent deleting occupied classroom",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/classrooms/{{classroom_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });",
                  "pm.test(\"JSON response\", function () { pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"); });",
                  "if (pm.response.code === 409) {",
                  "  const body = pm.response.json();",
                  "  pm.test(\"Error envelope\", function () { pm.expect(body.code).to.be.a(\"string\").and.not.empty; pm.expect(body.error).to.be.a(\"string\").and.not.empty; });",
                  "  pm.test(\"Conflict code\", function () { pm.expect(body.code).to.equal(\"CONFLICT\"); });",
                  "}"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "07 Cleanup sample data",
      "description": "ลบข้อมูลที่สร้างโดย collection เรียงตาม dependency และล้าง ID variables หลังลบสำเร็จ",
      "item": [
        {
          "name": "Delete student",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/v1/students/{{student_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", function () { pm.response.to.have.status(204); });",
                  "pm.test(\"Empty response body\", function () { pm.expect(pm.response.text()).to.equal(\"\"); });",
                  "if (pm.response.code === 204) pm.collectionVariables.unset(\"student_id\");"
                ]
              }
            }
          ],
          "response": []
        },
